# Mobile (Expo) environment — copy to .env.local (gitignored) and fill in.
# EXPO_PUBLIC_* values are embedded in the client bundle, so never put
# server secrets (JWT_SECRET, API keys, encryption keys) in this file.
EXPO_PUBLIC_API_URL=https://your-api.example.com
EXPO_PUBLIC_WS_URL=wss://your-api.example.com
