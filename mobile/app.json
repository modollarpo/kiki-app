// App Configuration
{
  "name": "KIKIMobile",
  "displayName": "KIKI Agent",
  "version": "1.0.0",
  "orientation": "portrait",
  "icon": "./assets/icon.png",
  "userInterfaceStyle": "dark",
  "backgroundColor": "#030712",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#030712"
  },
  "ios": {
    "bundleIdentifier": "ai.kiki.agent",
    "buildNumber": "1",
    "supportsTablet": true,
    "requireFullScreen": false,
    "infoPlist": {
      "NSFaceIDUsageDescription": "KIKI Agent uses Face ID to securely authenticate you.",
      "NSCameraUsageDescription": "KIKI Agent uses the camera for document scanning.",
      "UIBackgroundModes": ["fetch", "remote-notification"]
    },
    "config": {
      "usesNonExemptEncryption": false
    },
    "associatedDomains": ["applinks:kiki.ai", "applinks:app.kiki.ai"],
    "entitlements": {
      "aps-environment": "production"
    }
  },
  "android": {
    "package": "ai.kiki.agent",
    "versionCode": 1,
    "compileSdkVersion": 34,
    "targetSdkVersion": 34,
    "minSdkVersion": 31,
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#030712"
    },
    "permissions": [
      "android.permission.INTERNET",
      "android.permission.RECEIVE_BOOT_COMPLETED",
      "android.permission.VIBRATE",
      "android.permission.USE_BIOMETRIC",
      "android.permission.USE_FINGERPRINT"
    ],
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [{ "scheme": "https", "host": "kiki.ai" }],
        "category": ["BROWSABLE", "DEFAULT"]
      }
    ],
    "googleServicesFile": "./google-services.json"
  },
  "web": {
    "bundler": "metro",
    "output": "static",
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "expo-router",
    "expo-secure-store",
    [
      "expo-notifications",
      {
        "icon": "./assets/notification-icon.png",
        "color": "#10b981",
        "sounds": ["./assets/notification-sound.wav"]
      }
    ],
    [
      "expo-local-authentication",
      { "faceIDPermission": "Allow KIKI Agent to use Face ID" }
    ]
  ],
  "experiments": {
    "typedRoutes": true
  },
  "extra": {
    "eas": {
      "projectId": "kiki-agent-expo-project-id"
    },
    "apiUrl": "https://kiki-app.purplesky-3fddb402.swedencentral.azurecontainerapps.io",
    "wsUrl": "wss://kiki-app.purplesky-3fddb402.swedencentral.azurecontainerapps.io"
  },
  "updates": {
    "url": "https://u.expo.dev/kiki-agent-expo-project-id",
    "checkAutomatically": "ON_LOAD",
    "fallbackToCacheTimeout": 0
  },
  "runtimeVersion": {
    "policy": "appVersion"
  },
  "notification": {
    "icon": "./assets/notification-icon.png",
    "color": "#10b981",
    "iosDisplayInForeground": true
  },
  "githubUrl": "https://github.com/kiki-agent/kiki-platform"
}