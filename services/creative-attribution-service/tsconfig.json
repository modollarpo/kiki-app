{
    "compilerOptions":  {
                            "target":  "ES2020",
                            "module":  "commonjs",
                            "lib":  [
                                        "ES2020"
                                    ],
                            "outDir":  "./dist",
                            "strict":  true,
                            "esModuleInterop":  true,
                            "skipLibCheck":  true,
                            "forceConsistentCasingInFileNames":  true,
                            "resolveJsonModule":  true,
                            "declaration":  true,
                            "sourceMap":  true,
                            "paths":  {
                                          "@kiki/shared":  [
                                                               "../../packages/shared/src"
                                                           ]
                                      }
                        },
    "include":  [
                    "src/**/*"
                ],
    "exclude":  [
                    "node_modules",
                    "dist"
                ]
}
