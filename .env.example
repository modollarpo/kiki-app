# Azure OpenAI — Cheapest functional models for SyncBrain
# GPT-4.1-mini: ~$0.40/1M input tokens (classification, routing, Q&A)
# GPT-4o: ~$2.50/1M input tokens (creative, analysis, complex reasoning)
# Note: gpt-4o-mini (2024-07-18) is deprecated and cannot be deployed on Azure — use gpt-4.1-mini.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o

# ── Groq (ultra-low latency for real-time bidding) ──────────
# GPT-OSS 20B: <200ms for bid scoring, pacing, fast routing
# (replaces llama-3.1-8b-instant, retired by Groq 16 Aug 2026)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# ── Bidding Interval ────────────────────────────────────────
# How often the bidding cycle runs (ms). Default: 300000 (5 min)
BIDDING_INTERVAL_MS=300000

# ── OpenCode (headless agent backend) ──────────────────────
# When set, routes chat through OpenCode for file-aware responses
# Run: opencode serve --port 8080
OPENCODE_ENDPOINT=http://localhost:8080
OPENCODE_SECRET=

# ── Microservice URLs ──────────────────────────────────────
CREATIVE_ATTRIBUTION_URL=http://localhost:3021
MMM_URL=http://localhost:3022
COMPETITIVE_INTEL_URL=http://localhost:3023
PROFIT_MARGIN_URL=http://localhost:3024
NL_ANALYTICS_URL=http://localhost:3025
INFLUENCER_URL=http://localhost:3026

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Amazon Ads Connector ───────────────────────────────────
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_PROFILE_ID=

# ── CTV Connector ──────────────────────────────────────────
CTV_PROVIDER=roku
CTV_CLIENT_ID=
CTV_CLIENT_SECRET=
CTV_REFRESH_TOKEN=
CTV_PARTNER_ID=

# ── Commerce & CRM Connectors ─────────────────────────
# Shopify OAuth (Admin API) — get from https://apps.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/shopify

# WooCommerce OAuth (WOO Connect app) — register at https://woocommerce.com/my-account/apps/
WOO_CLIENT_ID=
WOO_CLIENT_SECRET=
WOO_STORE_URL=https://your-store.com
WOO_REDIRECT_URI=http://localhost:3000/api/auth/callback/woocommerce

# HubSpot OAuth (Private App / OAuth) — create at https://developers.hubspot.com/
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/callback/hubspot

# Salesforce OAuth (Connected App) — create at https://login.salesforce.com/setup
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/auth/callback/salesforce

# ── Client ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Seed Demo Data ──────────────────────────────
SEED_DEMO_DATA=false

# ── Stripe Webhooks ───────────────────────────
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth ──────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/sso/google/callback

# ── Meta Facebook OAuth ───────────────────────
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta
META_CONFIG_ID=
META_PIXEL_ID=

# ── LinkedIn OAuth ────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# ── Snapchat OAuth ────────────────────────────
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=http://localhost:3000/api/auth/callback/snap
SNAP_PIXEL_ID=

# ── TikTok OAuth ──────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok
TIKTOK_PIXEL_CODE=

# ── Pinterest OAuth ───────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/auth/callback/pinterest
PINTEREST_AD_ACCOUNT_ID=

# ── Redis (for rate limiting and caching) ──────────
REDIS_URL=redis://localhost:6379
