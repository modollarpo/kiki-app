# Azure OpenAI — Cheapest functional models for SyncBrain
# GPT-4o-mini: ~$0.15/1M input tokens (classification, routing, Q&A)
# GPT-4o: ~$2.50/1M input tokens (creative, analysis, complex reasoning)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o
