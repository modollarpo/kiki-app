# Azure OpenAI — Cheapest functional models for SyncBrain
# GPT-4o-mini: ~$0.15/1M input tokens (classification, routing, Q&A)
# GPT-4o: ~$2.50/1M input tokens (creative, analysis, complex reasoning)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o

# ── Groq (ultra-low latency for real-time bidding) ──────────
# Llama 3.1 8B: ~$0.05/1M input, <200ms response time
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant

# ── Bidding Interval ────────────────────────────────────────
# How often the bidding cycle runs (ms). Default: 300000 (5 min)
BIDDING_INTERVAL_MS=300000

# ── OpenCode (headless agent backend) ──────────────────────
# Routes chat through OpenCode for file-aware responses
# Run: opencode serve --port 8080
OPENCODE_ENDPOINT=http://localhost:8080
OPENCODE_SECRET=sk-0rrQ5H24fyepK8JgQzfL6WwHjUMWkvDvCdjkDy2kGTg6kE3SCh6DVlJTFp1bRXNO

# ── Microservice URLs ──────────────────────────────────────
CREATIVE_ATTRIBUTION_URL=http://localhost:3021
MMM_URL=http://localhost:3022
COMPETITIVE_INTEL_URL=http://localhost:3023
PROFIT_MARGIN_URL=http://localhost:3024
NL_ANALYTICS_URL=http://localhost:3025
INFLUENCER_URL=http://localhost:3026

# ── Kafka ──────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Amazon Ads Connector ───────────────────────────────────
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_PROFILE_ID=

# ── CTV Connector ──────────────────────────────────────────
CTV_PROVIDER=roku
CTV_CLIENT_ID=
CTV_CLIENT_SECRET=
CTV_REFRESH_TOKEN=
CTV_PARTNER_ID=

# ── Competitive Intelligence ───────────────────────────────
META_AD_LIBRARY_TOKEN=
TIKTOK_CREATIVE_CENTER_TOKEN=

# ── Redis (for rate limiting and caching) ──────────────────
REDIS_URL=redis://localhost:6379
