# ============================================================
# KIKI Agent Platform — Environment Template
# Copy to `.env.local` and fill in real values. NEVER commit secrets.
# ============================================================

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
# SQLite database file path (omit for default ./kiki.db)
DATABASE_PATH=./kiki.db

# ── Auth ────────────────────────────────────────────────────
# 32+ char random string used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string
# 32+ char random string used to encrypt stored secrets
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ── Azure OpenAI (real LLM) ─────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# ── Groq (ultra-low latency for real-time bidding) ──────────
# Llama 3.1 8B: <200ms for bid scoring, pacing, fast routing
GROQ_API_KEY=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
GROQ_MODEL=llama-3.1-8b-instant

# ── Bidding Interval ────────────────────────────────────────
# How often the bidding cycle runs (ms). Default: 300000 (5 min)
# Set to 900000 (15 min) if not using Groq, or 60000 (1 min) for aggressive bidding
BIDDING_INTERVAL_MS=300000

# ── OpenCode (headless agent backend) ──────────────────────
# When set, routes chat through OpenCode for file-aware responses
# Run: opencode serve --port 8080
OPENCODE_ENDPOINT=http://localhost:8080
OPENCODE_SECRET=sk-0rrQ5H24fyepK8JgQzfL6WwHjUMWkvDvCdjkDy2kGTg6kE3SCh6DVlJTFp1bRXNO

# ── Stripe (real billing SDK) ───────────────────────────────
# When unset, billing runs in simulated mode (no external calls).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: map each plan to a Stripe Price ID to create real
# subscriptions (metered usage + invoices) instead of simulated ids.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_OAAS=

# ── Client ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
