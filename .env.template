# ============================================================
# KIKI Agent Platform — Environment Template
# Copy to `.env.local` and fill in real values. NEVER commit secrets.
# ============================================================

# ── Core ────────────────────────────────────────────────────
NODE_ENV=development
# SQLite database file path (omit for default ./kiki.db)
DATABASE_PATH=./kiki.db

# ── Auth ────────────────────────────────────────────────────
# 32+ char random string used to sign session JWTs
JWT_SECRET=change-me-to-a-long-random-string
# 32+ char random string used to encrypt stored secrets
ENCRYPTION_KEY=change-me-to-another-long-random-string

# ── Azure OpenAI (real LLM) ─────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_STANDARD=gpt-4o
AZURE_OPENAI_DEPLOYMENT_MINI=gpt-4o-mini

# ── Groq (ultra-low latency for real-time bidding) ──────────
# Llama 3.1 8B: <200ms for bid scoring, pacing, fast routing
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ── Bidding Interval ────────────────────────────────────────
# How often the bidding cycle runs (ms). Default: 300000 (5 min)
# Set to 900000 (15 min) if not using Groq, or 60000 (1 min) for aggressive bidding
BIDDING_INTERVAL_MS=300000

# ── OpenCode (headless agent backend) ──────────────────────
# When set, routes chat through OpenCode for file-aware responses
# Run: opencode serve --port 8080
OPENCODE_ENDPOINT=http://localhost:8080
OPENCODE_SECRET=

# ── Stripe (real billing SDK) ───────────────────────────────
# When unset, billing runs in simulated mode (no external calls).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Optional: map each plan to a Stripe Price ID to create real
# subscriptions (metered usage + invoices) instead of simulated ids.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_OAAS=

# ── Webhooks (Platform Secrets) ─────────────────────────────
META_APP_SECRET=
TIKTOK_WEBHOOK_SECRET=
LINKEDIN_WEBHOOK_SECRET=
GOOGLE_WEBHOOK_SECRET=
SNAP_WEBHOOK_SECRET=
PINTEREST_WEBHOOK_SECRET=

# ── Commerce & CRM Connectors ─────────────────────────
# Shopify OAuth (Admin API) — get from https://apps.shopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_REDIRECT_URI=http://localhost:3000/api/auth/callback/shopify

# WooCommerce OAuth (WOO Connect app) — register at https://woocommerce.com/my-account/apps/
WOO_CLIENT_ID=
WOO_CLIENT_SECRET=
WOO_STORE_URL=https://your-store.com
WOO_REDIRECT_URI=http://localhost:3000/api/auth/callback/woocommerce

# HubSpot OAuth (Private App / OAuth) — create at https://developers.hubspot.com/
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/callback/hubspot

# Salesforce OAuth (Connected App) — create at https://login.salesforce.com/setup
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=https://your-instance.salesforce.com
SALESFORCE_REDIRECT_URI=http://localhost:3000/api/auth/callback/salesforce

# ── Client ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── Seed Demo Data ───────────────────────────────────
# Set to "true" only for local development with demo data. Production should be "false".
SEED_DEMO_DATA=false

# ── Stripe Webhooks ──────────────────────────────────
# Required for subscription management and payment tracking
STRIPE_WEBHOOK_SECRET=

# ── Google OAuth ──────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/sso/google/callback

# ── Meta Facebook OAuth ───────────────────────────────
# Create at https://developers.facebook.com/docs/facebook-login
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/api/auth/callback/meta
META_CONFIG_ID=
META_PIXEL_ID=

# ── LinkedIn OAuth ───────────────────────────────────
# Create at https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/auth/callback/linkedin

# ── Snapchat OAuth ───────────────────────────────────
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REDIRECT_URI=http://localhost:3000/api/auth/callback/snap
SNAP_PIXEL_ID=

# ── TikTok OAuth ─────────────────────────────────────
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/callback/tiktok
TIKTOK_PIXEL_CODE=

# ── Pinterest OAuth ──────────────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:3000/api/auth/callback/pinterest
PINTEREST_AD_ACCOUNT_ID=
