  "private": true,
  "author": "KIKI Agent Team <ops@kiki.ai>",
  "description": "KIKI Agent™ — Autonomous LTV Campaign Execution Platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:stubs": "node scripts/audit-fakes.mjs",
    "audit:deadlinks": "node scripts/deadlink-check.js",
    "predeploy": "npm run type-check && npm run lint && npm run test",
    "deploy": "node scripts/deploy.mjs",
    "video": "cd packages/demo-video && npm start",
    "video:build": "cd packages/demo-video && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5",
    "clsx": "^2",
    "date-fns": "^4",
    "framer-motion": "^14",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^1",
    "marked": "^18.1.1",
    "next": "16.4.2",
    "next-themes": "^0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "puppeteer": "^25.14.0",
    "react-hook-form": "^7",
    "react-hot-toast": "^2",
    "recharts": "^3",
    "stripe": "^23.0.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
