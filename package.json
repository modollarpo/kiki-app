  "private": true,
  "author": "KIKI Agent Team <ops@kiki.ai>",
  "description": "KIKI Agent™ — Autonomous LTV Campaign Execution Platform",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:stubs": "node scripts/audit-fakes.mjs",
    "audit:deadlinks": "node scripts/deadlink-check.js",
    "predeploy": "npm run type-check && npm run lint && npm run test",
    "deploy": "node scripts/deploy.mjs",
    "video": "cd packages/demo-video && npm start",
    "video:build": "cd packages/demo-video && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/react-query": "^5",
    "clsx": "^2",
    "date-fns": "^3",
