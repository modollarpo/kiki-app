    "jose": "^6.2.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0",
    "marked": "^18.0.7",
    "next": "15.5.28",
    "next-themes": "^0",
    "nodemailer": "^10.1.7",
    "pg": "^8.13.0",
    "puppeteer": "^25.3.0",
    "react-hook-form": "^7",
    "react-hot-toast": "^2",
    "recharts": "^2",
    "stripe": "^17.7.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^3.25.76",
    "zustand": "^4.5.0"
